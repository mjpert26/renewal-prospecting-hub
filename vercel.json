{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/app.js": { "includeFiles": "app/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/app" },
    { "source": "/index.html", "destination": "/api/app" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.force.com https://*.salesforce.com https://*.visualforce.com https://*.my.salesforce.com" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
