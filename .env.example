# Salesforce Connected App (OAuth + Canvas)
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v62.0

# Public base URL of this deployment, used for the OAuth callback
APP_URL=https://your-project.vercel.app

# Random 32+ character string used to encrypt the session cookie
SESSION_SECRET=

# Comma-separated emails of users who get the Manager view (any rep's view, read-only Hitlists)
MANAGER_EMAILS=

# Upstash Redis (added automatically by the Vercel Marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
